//command: wlan_unlock
cryptools = include_lib("/lib/crypto.so")
if not cryptools then exit("Error: Missing crypto library")
shell = get_shell
local = shell.host_computer

//set airmon to True
wlan_device_list = (local.network_devices).split(" ")
if wlan_device_list[2] == "False" then cryptools.airmon("start",wlan_device_list[0])

//get list of wlans in order of strongest connection
networks = local.wifi_networks(wlan_device_list[0])
network_map = []
for network in networks
	network = network.split(" ")
	if network[1].len() != 3 then network[1] = "0" + network[1]
	network_map.push({"ESSID":network[2],"BSSID":network[0],"Strength":network[1],"Password":null})
end for
network_map = network_map.sort("Strength",0)



//parse the list and create folders per BSSID

file_path = "/home/SerRipsen/WLANs.txt"
file = local.File(file_path)

lines = []
for outerKey in network_map.indexes
	inner = network_map[outerKey]
	for k in inner.indexes
		v = inner[k]
		lines.push(outerKey + "/" + k + "/" + v)
	end for
end for

file.set_content(lines.join(char(10)))





result = {}
raw = file.get_content
for line in raw.split(char(10))
	parts = line.split("/")
	if parts.len != 3 then continue   // skip malformed lines
	outerKey = parts[0]
	k = parts[1]
	v = parts[2]
	if not result.hasIndex(outerKey) then
		result[outerKey] = {}
	end if
	result[outerKey][k] = v
end for

print(result)
